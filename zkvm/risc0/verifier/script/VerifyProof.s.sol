pragma solidity ^0.8.19;

import "forge-std/Script.sol";
import "forge-std/console.sol";
import "../src/QuoteVerifier.sol";

/**
 * @title VerifyProof
 * @dev Script to verify zkVM proof on-chain using real proof data
 */
contract VerifyProof is Script {
    // Contract address on Sepolia
    address constant VERIFIER_ADDRESS = 0x4fa3ddCB722a7aA95f6409125dC60cC9CA5A4D16;
    
    // Real zkVM proof data extracted from binary files
    bytes constant REAL_SEAL = hex"";
    
    bytes constant REAL_JOURNAL = hex"";
    
    function run() external {
        uint256 deployerPrivateKey = vm.envUint("PRIVATE_KEY");
        address deployer = vm.addr(deployerPrivateKey);
        
        console.log("Verifying zkVM proof on-chain...");
        console.log("Verifier contract:", VERIFIER_ADDRESS);
        console.log("Deployer account:", deployer);
        console.log("Account balance:", deployer.balance);
        
        // Create contract instance
        QuoteVerifier verifier = QuoteVerifier(VERIFIER_ADDRESS);
        
        // Verify the contract is deployed
        bytes32 imageId = verifier.getImageId();
        console.log("Contract Image ID:");
        console.logBytes32(imageId);
        
        // Verify the proof
        console.log("Submitting proof verification...");
        console.log("Seal length:", REAL_SEAL.length);
        console.log("Journal length:", REAL_JOURNAL.length);
        
        vm.startBroadcast(deployerPrivateKey);
        
        // Call verifyQuote with real proof data
        bool success = verifier.verifyQuote(REAL_SEAL, REAL_JOURNAL);
        
        vm.stopBroadcast();
        
        if (success) {
            console.log("PROOF VERIFICATION SUCCESSFUL!");
            console.log("The zkVM proof has been verified on-chain");
        } else {
            console.log("PROOF VERIFICATION FAILED!");
            console.log("The zkVM proof could not be verified");
        }
        
        console.log("Verification complete!");
    }
}
